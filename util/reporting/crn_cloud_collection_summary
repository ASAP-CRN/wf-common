# ---------------------------------------------------------------------------


# Resolve the newest metadata/release/<version> prefix inside a curated bucket
# (e.g. metadata/release/v5.1.0/SAMPLE.csv; v3.0.0 < v4.0.0 < v5.0.0 < v5.1.0).
# Prints the gs:// prefix on success; returns 1 if there is no versioned release folder.
# Usage: resolve_curated_metadata_prefix <gs://asap-curated-bucket>
resolve_curated_metadata_prefix() {
    local curated_bucket="$1"
    local latest

    latest=$(gcloud storage ls "${curated_bucket}/metadata/release/" 2>/dev/null \
        | grep -E '/v[0-9][^/]*/$' | sed 's;/$;;' | sort -V | tail -1) || return 1
    [[ -n "$latest" ]] || return 1
    echo "$latest"
}

# Emit one output row for a released dataset from the CDE CSVs in its curated bucket.
# Returns 1 (caller should `continue`) if no usable curated metadata exists.
# Usage: process_curated_dataset <slug> <team_name> <releases_sheet_version>
process_curated_dataset() {
    local slug="$1"
    local team_name="$2"
    local sheet_version="$3"
    local dataset_id="${slug#prod-}"
    local cohort_flag=()
    [[ "$dataset_id" == cohort-* ]] && cohort_flag=(--cohort)

    local gcp_raw_bucket="gs://asap-raw-${dataset_id}"
    local gcp_prod_bucket="gs://asap-curated-${dataset_id}"

    if ! gcloud storage buckets describe "$gcp_prod_bucket" >/dev/null 2>&1; then
        echo "[WARNING] No curated bucket for [$slug]: [$gcp_prod_bucket]; skipping" >&2
        return 1
    fi
    if ! gcloud storage buckets describe "$gcp_raw_bucket" >/dev/null 2>&1; then
        echo "  [WARN] Raw bucket does not exist: [$gcp_raw_bucket]; reporting curated only" >&2
        gcp_raw_bucket="NA"
    fi

    local metadata_prefix
    if ! metadata_prefix=$(resolve_curated_metadata_prefix "$gcp_prod_bucket"); then
        echo "[WARNING] No metadata/release/<version>/ folder in [$gcp_prod_bucket]; skipping [$slug]" >&2
        return 1
    fi
    echo "  Reading curated metadata from [$metadata_prefix]"
    # The bucket is the source of truth for what was published; flag a stale sheet
    if [[ -n "$sheet_version" ]] && [[ "${metadata_prefix##*/}" != "$sheet_version" ]]; then
        echo "  [WARN] Releases sheet latest_release_version is [$sheet_version] but newest curated metadata is [${metadata_prefix##*/}]; using the curated bucket" >&2
    fi

    local tmpdir
    tmpdir=$(mktemp -d /tmp/curated_meta.XXXXXX)
    if ! gcloud storage cp "${metadata_prefix}/*.csv" "$tmpdir/" >/dev/null 2>&1; then
        echo "[WARNING] Could not download CSVs from [$metadata_prefix]; skipping [$slug]" >&2
        rm -rf "$tmpdir"
        return 1
    fi
    if ! compgen -G "$tmpdir/*.csv" >/dev/null; then
        echo "[WARNING] No CSVs downloaded from [$metadata_prefix]; skipping [$slug]" >&2
        rm -rf "$tmpdir"
        return 1
    fi

    local regions_file
    regions_file=$(mktemp /tmp/curated_regions.XXXXXX)

    local metrics
    if ! metrics=$(python3 "$CURATED_HELPER" \
        --slug "$slug" \
        --metadata-dir "$tmpdir" \
        --raw-bucket "$gcp_raw_bucket" \
        ${cohort_flag[@]+"${cohort_flag[@]}"} \
        --diag-labels-file "$_DIAG_LABELS_FILE" \
        --subject-membership "$subject_membership_file" \
        --sample-membership "$sample_membership_file" \
        --brain-donor-membership "$brain_donor_membership_file" \
        --subject-diagnosis-membership "$subject_diagnosis_membership_file" \
        --sample-region-membership "$sample_region_membership_file" \
        --human-ids "$_HUMAN_IDS_FILE" \
        --mouse-ids "$_MOUSE_IDS_FILE" \
        --cell-ids "$_CELL_IDS_FILE" \
        --brain-donor-ids "$_BRAIN_DONOR_IDS_FILE" \
        --sample-ids "$_SAMPLE_IDS_FILE" \
        --regions-out "$regions_file"); then
        echo "[WARNING] Curated metadata summary failed for [$slug]; skipping" >&2
        rm -rf "$tmpdir" "$regions_file"
        return 1
    fi

    # Fold this dataset's brain regions into the global unique list
    if [[ -s "$regions_file" ]]; then
        while IFS= read -r _region; do
            [[ -z "$_region" ]] && continue
            if ! echo "$unique_brain_regions" | grep -qF "$_region"; then
                unique_brain_regions="$unique_brain_regions|$_region"
            fi
        done < "$regions_file"
    fi
    rm -rf "$tmpdir" "$regions_file"

    # The helper prints two lines: the 7 scalar metrics, then the 25 diagnosis
    # columns plus condition_counts already in output-row shape.
    local sample_count n_subjects_unique n_samples_unique n_samples_total
    local brain_sample_count brain_region_count brain_donor_count diagnosis_row
    IFS=$'\t' read -r sample_count n_subjects_unique n_samples_unique n_samples_total \
        brain_sample_count brain_region_count brain_donor_count \
        <<< "$(sed -n 1p <<< "$metrics")"
    diagnosis_row=$(sed -n 2p <<< "$metrics")

    local gcp_raw_bucket_size gcp_prod_bucket_size
    if "${SAMPLES_SUBJECTS_ONLY}"; then
        gcp_raw_bucket_size="NA"
        gcp_prod_bucket_size="NA"
    else
        echo "Getting GCP raw bucket size"
        if [[ "$gcp_raw_bucket" == "NA" ]]; then
            gcp_raw_bucket_size="NA"
        else
            gcp_raw_bucket_size=$(gcloud storage du -s "$gcp_raw_bucket" 2>/dev/null | grep -oE '^[0-9]+' || echo "NA")
        fi
        echo "Getting GCP curated bucket size"
        gcp_prod_bucket_size=$(gcloud storage du -s "$gcp_prod_bucket" 2>/dev/null | grep -oE '^[0-9]+' || echo "NA")
    fi

    # Add a newline only if an appended-to TSV doesn't already end with one
    if [[ -s "$output_file" ]] && [[ -n "$(tail -c 1 "$output_file")" ]]; then
        printf "\n" >> "$output_file"
    fi
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t" \
        "$slug" "$gcp_raw_bucket" "$gcp_raw_bucket_size" \
        "$gcp_prod_bucket" "$gcp_prod_bucket_size" \
        "$team_name" "$sample_count" \
        "$n_subjects_unique" "$n_samples_unique" "$n_samples_total" \
        "$brain_sample_count" "$brain_region_count" "$brain_donor_count" >> "$output_file"
    printf "%s\n" "$diagnosis_row" >> "$output_file"

    return 0
}

# ---------------------------------------------------------------------------

# Released datasets from the Releases sheet: "<dataset_id>\t<latest_release_version>" per line
if ! RELEASED_DATASETS=$(python3 -c '
